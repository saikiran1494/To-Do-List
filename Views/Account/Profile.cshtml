@model FitnessApp.Models.User
@{
    ViewData["Title"] = "Profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card dashboard-card">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person-circle"></i> My Profile
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary">Personal Information</h5>
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Username:</strong></td>
                                    <td>@Model.Username</td>
                                </tr>
                                <tr>
                                    <td><strong>Name:</strong></td>
                                    <td>@Model.FirstName @Model.LastName</td>
                                </tr>
                                <tr>
                                    <td><strong>Email:</strong></td>
                                    <td>@Model.Email</td>
                                </tr>
                                <tr>
                                    <td><strong>Phone:</strong></td>
                                    <td>@(!string.IsNullOrEmpty(Model.Phone) ? Model.Phone : "Not provided")</td>
                                </tr>
                                <tr>
                                    <td><strong>Date of Birth:</strong></td>
                                    <td>@(Model.DateOfBirth?.ToString("MMM dd, yyyy") ?? "Not provided")</td>
                                </tr>
                                <tr>
                                    <td><strong>Gender:</strong></td>
                                    <td>@(!string.IsNullOrEmpty(Model.Gender) ? Model.Gender : "Not specified")</td>
                                </tr>
                                <tr>
                                    <td><strong>Member Since:</strong></td>
                                    <td>@Model.CreatedDate.ToString("MMM dd, yyyy")</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-info">Health Metrics</h5>
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Height:</strong></td>
                                    <td>@(Model.Height?.ToString("N2") ?? "Not set") cm</td>
                                </tr>
                                <tr>
                                    <td><strong>Weight:</strong></td>
                                    <td>@(Model.Weight?.ToString("N1") ?? "Not set") kg</td>
                                </tr>
                                <tr>
                                    <td><strong>Activity Level:</strong></td>
                                    <td>@(!string.IsNullOrEmpty(Model.ActivityLevel) ? Model.ActivityLevel : "Not set")</td>
                                </tr>
                                @if (Model.Height.HasValue && Model.Weight.HasValue && Model.Height > 0)
                                {
                                    var bmi = Model.Weight / ((Model.Height / 100) * (Model.Height / 100));
                                    var bmiCategory = bmi < 18.5m ? "Underweight" : 
                                                    bmi < 25m ? "Normal" : 
                                                    bmi < 30m ? "Overweight" : "Obese";
                                    var bmiColor = bmi < 18.5m ? "warning" : 
                                                 bmi < 25m ? "success" : 
                                                 bmi < 30m ? "warning" : "danger";
                                    
                                    <tr>
                                        <td><strong>BMI:</strong></td>
                                        <td>
                                            <span class="badge bg-@bmiColor">@bmi.Value.ToString("N1")</span>
                                            <small class="text-muted">(@bmiCategory)</small>
                                        </td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>
                    
                    <hr>
                    
                    <div class="text-center">
                        <a href="@Url.Action("Dashboard")" class="btn btn-primary">
                            <i class="bi bi-arrow-left"></i> Back to Dashboard
                        </a>
                        <button class="btn btn-outline-secondary" onclick="window.print()">
                            <i class="bi bi-printer"></i> Print Profile
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>