@model List<FitnessApp.Models.FitnessPlan>
@{
    ViewData["Title"] = "Fitness History";
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="card dashboard-card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="bi bi-activity"></i> Fitness History (Last @ViewBag.Days Days)
                    </h4>
                    <div class="btn-group" role="group">
                        <a href="@Url.Action("FitnessHistory", new { days = 7 })" 
                           class="btn btn-outline-light @(ViewBag.Days == 7 ? "active" : "")">7 Days</a>
                        <a href="@Url.Action("FitnessHistory", new { days = 30 })" 
                           class="btn btn-outline-light @(ViewBag.Days == 30 ? "active" : "")">30 Days</a>
                        <a href="@Url.Action("FitnessHistory", new { days = 90 })" 
                           class="btn btn-outline-light @(ViewBag.Days == 90 ? "active" : "")">90 Days</a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="row mb-3">
                            <div class="col-md-12">
                                @{
                                    var totalWorkouts = Model.Count;
                                    var completedWorkouts = Model.Count(f => f.IsCompleted);
                                    var totalCalories = Model.Sum(f => f.CaloriesBurned);
                                    var totalMinutes = Model.Sum(f => f.DurationMinutes);
                                    var completionRate = totalWorkouts > 0 ? (decimal)completedWorkouts / totalWorkouts * 100 : 0;
                                }
                                
                                <div class="row text-center mb-4">
                                    <div class="col-md-3">
                                        <div class="card bg-primary text-white">
                                            <div class="card-body">
                                                <h3>@totalWorkouts</h3>
                                                <p class="mb-0">Total Workouts</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card bg-success text-white">
                                            <div class="card-body">
                                                <h3>@completedWorkouts</h3>
                                                <p class="mb-0">Completed</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card bg-warning text-white">
                                            <div class="card-body">
                                                <h3>@totalCalories.ToString("N0")</h3>
                                                <p class="mb-0">Calories Burned</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card bg-info text-white">
                                            <div class="card-body">
                                                <h3>@(totalMinutes / 60).ToString("N1")</h3>
                                                <p class="mb-0">Hours Exercised</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Date</th>
                                        <th>Exercise</th>
                                        <th>Type</th>
                                        <th>Duration</th>
                                        <th>Calories</th>
                                        <th>Status</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var plan in Model)
                                    {
                                        <tr class="@(plan.IsCompleted ? "table-success" : "")">
                                            <td>@plan.PlanDate.ToString("MMM dd, yyyy")</td>
                                            <td><strong>@plan.PlanName</strong></td>
                                            <td>
                                                <span class="badge bg-secondary">@plan.ExerciseType</span>
                                            </td>
                                            <td>
                                                <i class="bi bi-clock"></i> @plan.DurationMinutes min
                                            </td>
                                            <td>
                                                <i class="bi bi-fire"></i> @plan.CaloriesBurned cal
                                            </td>
                                            <td>
                                                @if (plan.IsCompleted)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-check-circle"></i> Completed
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">
                                                        <i class="bi bi-clock"></i> Pending
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(plan.Notes))
                                                {
                                                    <small class="text-muted">@plan.Notes</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">-</small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x display-1 text-muted"></i>
                            <h4 class="text-muted mt-3">No Fitness Records Found</h4>
                            <p class="text-muted">Start tracking your workouts to see them here!</p>
                            <a href="@Url.Action("Dashboard")" class="btn btn-primary">
                                <i class="bi bi-arrow-left"></i> Back to Dashboard
                            </a>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("Dashboard")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Dashboard
                        </a>
                        <a href="@Url.Action("DietHistory")" class="btn btn-outline-primary">
                            <i class="bi bi-journal-text"></i> View Diet History
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>